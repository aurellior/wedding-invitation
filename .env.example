# Supabase Configuration (Wajib diisi untuk Autentikasi Admin, Database PostgreSQL & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Opsional: Daftar email admin yang diizinkan mengakses Back-Office (pisahkan dengan koma)
# ADMIN_EMAILS=admin@example.com,organizer@example.com

# Public Base URL (Digunakan untuk generator link undangan WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
